<?xml version="1.0" encoding="utf-8"?>
<!-- 款式 C：珍珠悬浮胶囊卡（1:1 复刻网站首页「正在上课」蓝光胶囊基因） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_pearl_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetDateHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="今日课表"
            android:textColor="@color/widget_ink"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetWeekPill"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/widget_glass_glacier_wk"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:text="校务智理"
            android:textColor="@color/widget_accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widgetAiBtn"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/widget_pill_ai"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="✦ 问AI"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- 第 1 节：首页同款蓝光胶囊焦点条 -->
        <LinearLayout
            android:id="@+id/widgetRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_glass_pearl_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="9dp"
            android:paddingTop="8dp"
            android:paddingRight="9dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_glass_pearl_orb"
                android:gravity="center"
                android:text="课"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widgetHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widgetHeroSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_sub"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widgetHeroBadge"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/widget_glass_pearl_badge"
                android:gravity="center"
                android:maxLines="1"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:textColor="@color/widget_accent"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 第 2 节：轻盈珍珠次级胶囊 -->
        <LinearLayout
            android:id="@+id/widgetRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/widget_glass_pearl_next"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="7dp"
            android:paddingRight="12dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/widget_glass_pearl_dot" />

            <TextView
                android:id="@+id/widgetNextTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetNextRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:maxEms="6"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetEmptyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_glass_pearl_next"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/widgetEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日暂无剩余课程"
                android:textColor="@color/widget_ink"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetEmptySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="点击进入校务智理同步课表 ✨"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="2dp"
        android:paddingRight="2dp">

        <TextView
            android:id="@+id/widgetTaskBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="待办：等待同步"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetMoreHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全部课表 ›"
            android:textColor="@color/widget_sub"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
